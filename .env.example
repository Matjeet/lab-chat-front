# Copia este archivo a .env.local y ajusta los valores.
# Las variables NEXT_PUBLIC_* se inyectan en el bundle en tiempo de build.

# Base URL del microservicio chat-registro (sin barra final).
# Por defecto (si no se define): http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Configuración del proyecto Firebase para el SDK de cliente (Authentication).
# Sale de la consola de Firebase: Configuración del proyecto > General >
# "Tus apps" > SDK de tu app web. No son valores secretos (viajan en el
# bundle de cualquier app Firebase), pero deben ser los del MISMO proyecto
# que usa chat-registro (Admin SDK) para el alta de usuarios.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
