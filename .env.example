# Copia este archivo a .env.local y ajusta los valores.
# Las variables NEXT_PUBLIC_* se inyectan en el bundle en tiempo de build.

# Base URL del microservicio chat-registro (sin barra final).
# Por defecto (si no se define): http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- Firebase Auth ---
# Copia estos valores de Firebase Console > Configuración del proyecto >
# Tus apps > SDK config. Son claves públicas (van en el bundle del cliente);
# la seguridad la dan las reglas de Firebase, no que esto esté oculto.
# Sin esto, cualquier intento de registro falla con un error de Firebase.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
